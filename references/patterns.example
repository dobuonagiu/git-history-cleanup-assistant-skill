# Pattern custom per scripts/scan-patterns.sh   (formato: nome::regex-ERE, una per riga)
# I pattern reali (domini/IP/identità interni) NON vanno committati: tenere il file fuori dal repo.
# Copiare questo file, adattarlo e passarlo con --patterns-file.

# Domini interni (esempi)
internal-domain::[A-Za-z0-9.-]+\.(internal|corp|intra)\b
company-private-domain::\b[a-z0-9-]+\.intranet\.example\.com\b

# Connection string con credenziali
db-url-with-password::[a-z]+://[^/:@ ]+:[^/@ ]+@[^/ ]+

# Token in query string
token-in-url::[?&](token|api_key|apikey|access_token)=[A-Za-z0-9._-]{8,}

# Email aziendali di persone (sostituire il dominio)
corp-email::\b[A-Za-z0-9._%+-]+@example-corp\.com\b

# Telefoni (formato italiano, esempio)
it-phone::\b(\+39[ ]?)?3[0-9]{2}[ ]?[0-9]{6,7}\b

# Codice fiscale
it-codice-fiscale::\b[A-Z]{6}[0-9]{2}[A-Z][0-9]{2}[A-Z][0-9]{3}[A-Z]\b

# Identità/nomi da proteggere (uno per riga, case-sensitive)
# identity-mario-rossi::Mario Rossi
